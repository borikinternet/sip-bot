[Unit]
Description=Local natural-science SIP assistant
After=network-online.target sip-bot-ollama.service systemd-nspawn@freeswitch-bookworm.service
Wants=network-online.target sip-bot-ollama.service systemd-nspawn@freeswitch-bookworm.service

[Service]
Type=simple
User=inrack
WorkingDirectory=/home/inrack/sip-bot
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=/home/sipbot/.local/cpython-3.14.7t/lib/python3.14t/site-packages
Environment=LD_LIBRARY_PATH=/home/sipbot/.cache/sip-bot-c4-xtts-v2-3.14.7t/lib/python3.14t/site-packages/ctranslate2.libs
ExecStart=/home/sipbot/.cache/sip-bot-c4-xtts-v2-3.14.7t/bin/python -I tools/run_live_bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
