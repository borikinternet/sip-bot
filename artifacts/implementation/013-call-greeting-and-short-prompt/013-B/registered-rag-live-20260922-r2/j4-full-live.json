          "call_id": "call-in-0",
          "knowledge_context_id": null,
          "revision": 11,
          "role": "user",
          "source_ids": [],
          "text": "Стоп, а какие данные нужны для заявки?",
          "turn_id": "call-in-0:turn-3"
