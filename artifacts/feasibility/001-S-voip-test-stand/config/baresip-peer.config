# Headless local peer configuration for feasibility testing.
poll_method       epoll
sip_listen        127.0.0.1:5060
call_local_timeout 10
call_max_calls    2
rtp_ports         10000-10020
rtcp_mux          no
rtp_stats         yes
module_path       /usr/lib/baresip/modules
module            g711.so
module_tmp        uuid.so
module_tmp        account.so
module_app        echo.so
